generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  role             UserRole           @default(USER)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Company          Company[]
  DigitalSignature DigitalSignature[]
}

model Company {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  name               String
  type               String
  taxId              String
  activity           String
  employeeCount      Int
  address            String
  website            String?
  email              String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditApplications CreditApplication[]
}

model CreditApplication {
  id               Int                @id @default(autoincrement())
  companyId        Int
  requestedAmount  Int
  status           ApplicationStatus  @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  digitalSignature DigitalSignature[]
  documents        Document[]
}

model Document {
  id                  Int                @id @default(autoincrement())
  creditApplicationId Int
  url                 String
  uploadedAt          DateTime           @default(now())
  digitalSignatures   DigitalSignature[]
  creditApplication   CreditApplication  @relation(fields: [creditApplicationId], references: [id], onDelete: Cascade)
}

model DigitalSignature {
  id                  Int               @id @default(autoincrement())
  creditApplicationId Int
  documentId          Int
  signedAt            DateTime          @default(now())
  signedDocumentUrl   String
  signerId            Int?
  creditApplication   CreditApplication @relation(fields: [creditApplicationId], references: [id], onDelete: Cascade)
  document            Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer              User?             @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@unique([creditApplicationId, documentId])
}

enum UserRole {
  USER
  ADMIN
  OPERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}